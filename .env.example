# ============= CONEXIÓN A LA BASE DE DATOS EN SUPABASE =============
SUPABASE_URL="" # URL de tu proyecto en Supabase
SUPABASE_KEY="" # Clave de API de tu proyecto en Supabase
DB_USER="" # Usuario de la base de datos
DB_PASSWORD="" # Contraseña de la base de datos
DB_HOST="" # Host de PostgreSQL generado por Supabase
DB_PORT="" # Puerto para conexión a base de datos, por defecto es 5432
DB_NAME="" # Nombre de la base de datos

# ============= CONFIGURACIÓN JWT =============
JWT_SECRET_KEY="tu_jwt_secret_key_super_segura_aqui" # Clave secreta para firmar tokens JWT
ALGORITHM="HS256" # Algoritmo de firma JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30 # Tiempo de expiración del token en minutos

# ============= CONFIGURACIÓN CSRF =============
CSRF_SECRET_KEY="tu_csrf_secret_key_super_segura_aqui" # Clave para firmar tokens CSRF

# ============= CONFIGURACIÓN DE COOKIES =============
COOKIE_SECURE=False # True en producción (requiere HTTPS)
COOKIE_SAMESITE=lax # "lax" o "strict"
COOKIE_DOMAIN= # Dominio de las cookies (dejar vacío para localhost)

# ============= CONFIGURACIÓN DE FRONTEND =====
FRONTEND_URL=http://localhost:3000 # URL del frontend para CORS
BACKEND_URL=http://localhost:8000

# ============= ENTORNO =============
ENVIRONMENT=development # development o production

# ============ CONFIGURACIÓN DE ENCRIPTACIÓN =====
ENCRYPTION_KEY="TU_ENCRYPTION_KEY"

# ============= CONFIGURACIÓN DE EMAIL =============
RESEND_API_KEY=re_123456789
SECRET_KEY=tu_super_secret_key_aleatoria
EMAIL_FROM=onboarding@resend.dev